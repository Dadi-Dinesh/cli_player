# Optional. VLC 3 is detected in /Applications or on PATH by default.
# VLC_PATH=/Applications/VLC.app/Contents/MacOS/VLC

# Optional Audius credentials for read-only requests.
# AUDIUS_BEARER_TOKEN=
# AUDIUS_API_KEY=

# Required only for YouTube keyword searches. Enable YouTube Data API v3 first.
# YOUTUBE_API_KEY=

# Optional executable override. The default runs yt-dlp from PATH.
# YT_DLP_PATH=/opt/homebrew/bin/yt-dlp
